<div class="flex items-center">
  <h1 class="app-main-title">{{ translate('Work documents') }} > {{ translate('Settings') }}</h1>
</div>

<div class="card mt-10 w-1/2 m-auto">
  <div class="card-body">
    <p class="mb-4">{{ translate('The states of work documents are a Hubleto workflow. You can rename them or add your own states.') }}</p>
    {% if viewParams.mayEditWorkflows %}
      <a href="{{ config.projectUrl }}/workflow/workflows" class="btn btn-transparent">
        <span class="icon"><i class="fas fa-timeline"></i></span>
        <span class="text">{{ translate('Document states') }}</span>
      </a>
    {% endif %}
  </div>
</div>
